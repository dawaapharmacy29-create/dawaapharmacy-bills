{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "address": {
      "type": "string",
      "description": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "\u0643\u0627\u0634",
        "\u0622\u062c\u0644",
        "\u0627\u0646\u0633\u062a\u0627",
        "\u0641\u0648\u062f\u0627\u0641\u0648\u0646"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "payment_terms_days": {
      "type": "number",
      "description": "\u0645\u062f\u0629 \u0627\u0644\u0627\u0626\u062a\u0645\u0627\u0646 \u0628\u0627\u0644\u0623\u064a\u0627\u0645 (\u0645\u062b\u0644 30\u060c 60\u060c 90)",
      "default": 30
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "supplier_type": {
      "type": "string",
      "enum": [
        "external_supplier",
        "internal_branch"
      ],
      "default": "external_supplier",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0648\u0631\u062f: \u0645\u0648\u0631\u062f \u062e\u0627\u0631\u062c\u064a / \u0641\u0631\u0639 \u062f\u0627\u062e\u0644\u064a"
    },
    "linked_branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639 \u0627\u0644\u0645\u0631\u062a\u0628\u0637 (\u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0645\u0648\u0631\u062f \u0641\u0631\u0639\u064b\u0627 \u062f\u0627\u062e\u0644\u064a\u064b\u0627)"
    },
    "default_purchase_category": {
      "type": "string",
      "enum": [
        "medicines",
        "supplies_accessories",
        "mixed",
        "none"
      ],
      "default": "none",
      "description": "\u062a\u0635\u0646\u064a\u0641 \u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0627\u0644\u0645\u0648\u0631\u062f: \u0623\u062f\u0648\u064a\u0629 / \u0645\u0633\u062a\u0644\u0632\u0645\u0627\u062a \u0648\u0625\u0643\u0633\u0633\u0648\u0627\u0631 / \u0645\u062e\u062a\u0644\u0637 / \u063a\u064a\u0631 \u0645\u062d\u062f\u062f"
    },
    "default_payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "credit",
        "mixed",
        "none"
      ],
      "default": "none",
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629: \u0643\u0627\u0634 / \u0622\u062c\u0644 / \u0645\u062e\u062a\u0644\u0637 / \u063a\u064a\u0631 \u0645\u062d\u062f\u062f"
    },
    "exclude_from_net_purchases": {
      "type": "boolean",
      "default": false,
      "description": "\u0627\u0633\u062a\u0628\u0639\u0627\u062f \u0641\u0648\u0627\u062a\u064a\u0631 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0631\u062f \u0645\u0646 \u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0627\u064b"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}