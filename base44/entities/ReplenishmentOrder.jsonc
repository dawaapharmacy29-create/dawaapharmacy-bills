{
  "name": "ReplenishmentOrder",
  "type": "object",
  "properties": {
    "product_name": {
      "type": "string",
      "description": "اسم الصنف"
    },
    "product_code": {
      "type": "string",
      "description": "كود الصنف"
    },
    "branch": {
      "type": "string",
      "enum": [
        "دواء شكري",
        "دواء الشامي"
      ],
      "description": "الفرع"
    },
    "requested_quantity": {
      "type": "number",
      "description": "الكمية المطلوبة"
    },
    "actual_balance": {
      "type": "number",
      "description": "الرصيد الفعلي",
      "default": 0
    },
    "order_status": {
      "type": "string",
      "enum": [
        "pending",
        "ordered",
        "shortage"
      ],
      "default": "pending",
      "description": "حالة الطلب"
    },
    "notes": {
      "type": "string",
      "description": "ملاحظات"
    },
    "supplier_name": {
      "type": "string",
      "description": "المورد الذي تم الطلب منه"
    },
    "expected_arrival_date": {
      "type": "string",
      "format": "date",
      "description": "موعد الوصول المتوقع"
    },
    "received_quantity": {
      "type": "number",
      "default": 0,
      "description": "الكمية المستلمة"
    },
    "purchase_price": {
      "type": "number",
      "description": "سعر الشراء"
    },
    "approved_by": {
      "type": "string",
      "description": "المسؤول عن الاعتماد"
    },
    "received_by": {
      "type": "string",
      "description": "المسؤول عن الاستلام"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "وقت إغلاق الطلب"
    }
  },
  "required": [
    "product_name",
    "branch",
    "requested_quantity"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}
