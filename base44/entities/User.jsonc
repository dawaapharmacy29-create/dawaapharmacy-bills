{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "viewer"
      ],
      "default": "viewer"
    },
    "can_delete_invoice": {
      "type": "boolean",
      "description": "\u0635\u0644\u0627\u062d\u064a\u0629 \u062d\u0630\u0641 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631",
      "default": false
    },
    "can_save_invoice": {
      "type": "boolean",
      "description": "\u0635\u0644\u0627\u062d\u064a\u0629 \u0625\u0636\u0627\u0641\u0629 \u0648\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631",
      "default": false
    },
    "can_manage_team": {
      "type": "boolean",
      "description": "\u0635\u0644\u0627\u062d\u064a\u0629 \u0625\u062f\u0627\u0631\u0629 \u0641\u0631\u064a\u0642 \u0627\u0644\u0639\u0645\u0644",
      "default": false
    },
    "can_set_budget": {
      "type": "boolean",
      "description": "\u0635\u0644\u0627\u062d\u064a\u0629 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a",
      "default": false
    }
  },
  "required": []
}