{
  "name": "SyncOutbox",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0641\u0631\u064a\u062f \u0644\u0644\u062d\u062f\u062b (UUID)"
    },
    "entity_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0640 Entity \u0627\u0644\u0623\u0635\u0644\u064a \u0641\u064a Base44"
    },
    "record_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u0623\u0635\u0644\u064a"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0645\u0644\u064a\u0629"
    },
    "payload": {
      "type": "string",
      "description": "\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0633\u062c\u0644 \u0628\u0635\u064a\u063a\u0629 JSON"
    },
    "source_created_at": {
      "type": "string",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u0623\u0635\u0644\u064a"
    },
    "source_updated_at": {
      "type": "string",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0622\u062e\u0631 \u062a\u0639\u062f\u064a\u0644 \u0644\u0644\u0633\u062c\u0644 \u0627\u0644\u0623\u0635\u0644\u064a"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "synced",
        "pending_retry",
        "failed"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629"
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u062d\u0627\u0648\u0644\u0627\u062a \u0627\u0644\u0625\u0631\u0633\u0627\u0644"
    },
    "last_attempt_at": {
      "type": "string",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0622\u062e\u0631 \u0645\u062d\u0627\u0648\u0644\u0629"
    },
    "last_error": {
      "type": "string",
      "description": "\u0622\u062e\u0631 \u0631\u0633\u0627\u0644\u0629 \u062e\u0637\u0623"
    },
    "synced_at": {
      "type": "string",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629 \u0627\u0644\u0646\u0627\u062c\u062d\u0629"
    },
    "response_data": {
      "type": "string",
      "description": "\u0627\u0633\u062a\u062c\u0627\u0628\u0629 Supabase \u0628\u0635\u064a\u063a\u0629 JSON"
    }
  },
  "required": [
    "event_id",
    "entity_name",
    "record_id",
    "event_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
